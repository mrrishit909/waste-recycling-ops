  "/v1/containers/risk": {
   "get": {
    "tags": [
     "containers"
    ],
    "summary": "Overflow risk per container at 8, 24 and 48 hours from its last reading and its own fill rates by weekday; stale sensors flagged",
    "operationId": "containers_risk_v1_containers_risk_get",
    "parameters": [
     {
      "name": "min_p",
      "in": "query",
      "required": false,
      "schema": {
       "type": "number",
       "maximum": 1,
       "minimum": 0,
       "default": 0.0,
       "title": "Min P"
      }
     },
     {
      "name": "limit",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer",
       "maximum": 500,
       "minimum": 1,
       "default": 60,
       "title": "Limit"
      }
     },
     {
      "name": "authorization",
      "in": "header",
      "required": false,
      "schema": {
       "anyOf": [
