  "/v1/materials/destination": {
   "post": {
    "tags": [
     "facilities"
    ],
    "summary": "Send each load to the facility that maximises material value less haul cost within what each can still take today (a linear programme); the nearest accepting facility beside it, with what it would turn away",
    "operationId": "destination_v1_materials_destination_post",
    "parameters": [
     {
      "name": "Idempotency-Key",
      "in": "header",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Idempotency-Key"
