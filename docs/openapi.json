 },
 "components": {
  "schemas": {
   "DestinationIn": {
    "properties": {
     "loads": {
      "items": {
       "$ref": "#/components/schemas/Load"
      },
      "type": "array",
      "maxItems": 40,
      "title": "Loads"
     },
     "from_plan": {
      "type": "boolean",
      "title": "From Plan",
      "description": "add today's planned trips as loads, one per trip and stream, from where their last stop is",
      "default": false
     },
     "apply": {
      "type": "boolean",
      "title": "Apply",
      "description": "record the deliveries, so facility capacity is consumed",
      "default": false
     }
    },
    "type": "object",
    "title": "DestinationIn"
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "Load": {
    "properties": {
     "vehicle": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Vehicle"
     },
     "stream": {
      "type": "string",
      "enum": [
       "residual",
       "recycling",
       "organics",
       "glass"
      ],
      "title": "Stream"
     },
     "kg": {
      "type": "number",
      "maximum": 20000.0,
      "exclusiveMinimum": 0.0,
      "title": "Kg"
     },
     "at": {
      "items": {
       "type": "number"
      },
      "type": "array",
      "maxItems": 2,
      "minItems": 2,
      "title": "At",
      "description": "where the truck is, km on the grid"
     }
    },
    "type": "object",
    "required": [
     "stream",
     "kg",
     "at"
    ],
    "title": "Load"
   },
   "LoadIn": {
    "properties": {
     "seed": {
      "type": "integer",
      "maximum": 1000000.0,
      "minimum": 0.0,
      "title": "Seed",
      "default": 17
     }
    },
    "type": "object",
    "title": "LoadIn"
   },
   "Policy": {
    "properties": {
     "p_overflow_24h": {
      "type": "number",
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "P Overflow 24H",
      "description": "collect if the chance of overflowing in 24 hours is at least this",
      "default": 0.3
     },
     "expected_24h": {
      "type": "number",
      "maximum": 130.0,
      "minimum": 0.0,
      "title": "Expected 24H",
      "description": "or if the expected fill in 24 hours is at least this",
      "default": 80
     }
    },
    "type": "object",
    "title": "Policy"
   },
   "PollIn": {
    "properties": {
     "hours": {
      "type": "integer",
      "maximum": 48.0,
      "minimum": 1.0,
      "title": "Hours"
     }
    },
    "type": "object",
    "required": [
     "hours"
    ],
    "title": "PollIn"
   },
   "Reading": {
    "properties": {
     "sensor_id": {
      "type": "string",
      "maxLength": 40,
      "title": "Sensor Id"
     },
     "ts": {
      "type": "string",
      "format": "date-time",
      "title": "Ts"
     },
     "fill_pct": {
      "type": "number",
      "title": "Fill Pct"
     },
     "temp_c": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "title": "Temp C"
     },
     "battery_pct": {
      "anyOf": [
       {
        "type": "number",
        "maximum": 100.0,
        "minimum": 0.0
       },
       {
        "type": "null"
       }
      ],
      "title": "Battery Pct"
     }
    },
    "type": "object",
    "required": [
     "sensor_id",
     "ts",
     "fill_pct"
    ],
    "title": "Reading"
   },
   "RoutesIn": {
    "properties": {
     "policy": {
      "$ref": "#/components/schemas/Policy"
     },
     "time_limit_s": {
      "type": "integer",
      "maximum": 30.0,
      "minimum": 2.0,
      "title": "Time Limit S",
      "default": 8
     }
    },
    "type": "object",
    "title": "RoutesIn"
   },
   "TelemetryIn": {
    "properties": {
     "readings": {
      "items": {
       "$ref": "#/components/schemas/Reading"
      },
      "type": "array",
      "maxItems": 2000,
      "minItems": 1,
      "title": "Readings"
     }
    },
    "type": "object",
    "required": [
     "readings"
    ],
    "title": "TelemetryIn"
   },
   "ValidationError": {
    "properties": {
     "loc": {
      "items": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "integer"
        }
       ]
      },
      "type": "array",
      "title": "Location"
     },
     "msg": {
      "type": "string",
      "title": "Message"
     },
     "type": {
      "type": "string",
      "title": "Error Type"
     },
     "input": {
      "title": "Input"
     },
     "ctx": {
      "type": "object",
      "title": "Context"
     }
    },
    "type": "object",
    "required": [
     "loc",
     "msg",
     "type"
    ],
    "title": "ValidationError"
   },
   "VisionIn": {
    "properties": {
     "facility": {
      "type": "string",
      "maxLength": 60,
      "title": "Facility"
     },
     "images_png_base64": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "maxItems": 64,
      "minItems": 1,
      "title": "Images Png Base64"
     },
     "contamination_alert_share": {
      "type": "number",
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Contamination Alert Share",
      "default": 0.1
     }
    },
    "type": "object",
    "required": [
     "facility",
     "images_png_base64"
    ],
    "title": "VisionIn"
   }
  }
 }
}